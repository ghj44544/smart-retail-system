{
  "behaviors_path": "",
  "orders_path": "retail_algorithm/data/uci_online_retail_ii/orders.csv",
  "output_dir": "retail_algorithm/outputs_uci_experiment",
  "reference_date": null,
  "top_n": 10,
  "behavior_weights": {
    "view": 1.0,
    "favorite": 2.0,
    "cart": 3.0,
    "purchase": 5.0
  },
