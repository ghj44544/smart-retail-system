    "time_decay_days": 60,
    "seed": 42
  },
  "sampling": {
    "max_order_lines": 20000,
    "random_state": 42
  },
  "evaluation": {
    "enabled": true,
    "target_behavior": "purchase",
    "filter_seen": false,
    "k_values": [10, 50]
  }
